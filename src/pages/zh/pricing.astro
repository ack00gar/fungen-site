---
import Article from '../../layouts/Article.astro';
import PricingSection from '../../components/PricingSection.astro';

const title = 'FunGen 价格：免费下载，一次性付款解锁 Pro';
const description =
  'FunGen 免费下载，包含完整编辑器、视频库和 AI 预览。一次性付款解锁全品质 Pro AI 模型，无订阅、无限制。支持 PayPal，中国大陆用户可用 USDT（TRC-20）同价购买，不加价。';
const canonicalPath = '/zh/pricing';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'FunGen 价格',
  description,
  inLanguage: 'zh-Hans',
  dateModified: '2026-07-31',
  mainEntityOfPage: 'https://fungen.app/zh/pricing',
  author: { '@type': 'Organization', name: 'FunGen' },
  publisher: {
    '@type': 'Organization',
    name: 'FunGen',
    logo: { '@type': 'ImageObject', url: 'https://fungen.app/icon-512.png' },
  },
};
const breadcrumbs = [{ name: '价格', path: '/zh/pricing' }];
---

<Article
  {title}
  {description}
  heading="FunGen 价格"
  lang="zh"
  {canonicalPath}
  {articleLd}
  {breadcrumbs}
  hideCtaRow
>
  <p class="lead">
    FunGen <strong>免费下载</strong>，完整编辑器、视频库、批量处理和设备控制全部包含在内。
    <strong>一次性付款</strong>即可解锁全品质 Pro AI 模型——没有订阅，没有循环扣费。
    你制作或编辑的 funscript 永远归你所有，可自由分享或出售。
  </p>
  <p>
    支持 PayPal 和银行卡付款。<strong>中国大陆用户</strong>可以直接用
    <strong>USDT（TRC-20）</strong>购买：与 PayPal 同价、按实时汇率换算、不额外加价，
    下方价格区有收款地址和图文教程。所有付费档位都会通过电子邮件发送签名 Pass。
  </p>

  <PricingSection slot="full" lang="zh" standalone />
</Article>
